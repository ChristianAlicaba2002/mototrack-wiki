rules_version = '2';

// MotoTrack Firestore security rules.
//
// Data model (TypeScript types: src/lib/firestore/types.ts):
//   users/{uid}                              profile, owner only; optional serviceIntervals and
//                                            notificationPrefs. The owner can delete it (account deletion)
//   users/{uid}/bikes/{bikeId}               owner only
//   users/{uid}/bikes/{bikeId}/odometerReadings/{id}
//                                            owner only, append-only, matches the bike's odometerKm
//   users/{uid}/services/{serviceId}         owner only, bikeId must be one of the owner's bikes
//   users/{uid}/documents/{documentId}       owner only; its photo is base64 chunks in photoChunks/{photoId}_{n}
//   users/{uid}/devices/{deviceId}           owner only; FCM push token for one phone
//   users/{uid}/chats/{chatId}               owner only
//   users/{uid}/chats/{chatId}/messages/{id} owner only, append-only; the app writes both the
//                                            user's messages and the assistant's replies
//   wiki/{articleId}                         read-only for signed-in users
//
// Anything not matched below is denied.
// Tests: tests/rules/firestore.test.mjs (pnpm test:rules).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function data() {
      return request.resource.data;
    }

    // The document has exactly these fields: no missing, no extra.
    function hasExactly(fields) {
      return data().keys().hasAll(fields) && data().keys().hasOnly(fields);
    }

    // createdAt and updatedAt must be serverTimestamp() on create.
    function validCreateTimestamps() {
      return data().createdAt == request.time && data().updatedAt == request.time;
    }

    // createdAt can't change; updatedAt must be serverTimestamp().
    function validUpdateTimestamps() {
      return data().createdAt == resource.data.createdAt && data().updatedAt == request.time;
    }

    function isText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isOptionalText(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isNonNegative(value) {
      return value is number && value >= 0;
    }

    function isOptionalNonNegative(value) {
      return value == null || isNonNegative(value);
    }

    function isOptionalTimestamp(value) {
      return value == null || value is timestamp;
    }

    function bikeExists(uid, bikeId) {
      return bikeId is string
        && exists(/databases/$(database)/documents/users/$(uid)/bikes/$(bikeId));
    }

    function isOptionalBike(uid, bikeId) {
      return bikeId == null || bikeExists(uid, bikeId);
    }

    // ---------- users/{uid} ----------

    match /users/{uid} {
      // A km interval for one service type: missing, null (no reminder), or a
      // whole number from 100 to 100,000. Keep in sync with SERVICE_INTERVAL_LIMITS.
      function validInterval(intervals, type) {
        return !(type in intervals)
          || intervals[type] == null
          || (intervals[type] is int && intervals[type] >= 100 && intervals[type] <= 100000);
      }

      // Optional; missing means the app's default intervals.
      function validServiceIntervals() {
        let intervals = data().get('serviceIntervals', {});
        return intervals is map
          && intervals.keys().hasOnly([
            'oil_change', 'tires', 'brakes', 'chain', 'battery', 'inspection', 'repair', 'other'
          ])
          && validInterval(intervals, 'oil_change')
          && validInterval(intervals, 'tires')
          && validInterval(intervals, 'brakes')
          && validInterval(intervals, 'chain')
          && validInterval(intervals, 'battery')
          && validInterval(intervals, 'inspection')
          && validInterval(intervals, 'repair')
          && validInterval(intervals, 'other');
      }

      // Optional; missing means every reminder is on.
      function validNotificationPrefs() {
        let prefs = data().get('notificationPrefs', {});
        return prefs is map
          && prefs.keys().hasOnly(['serviceDue', 'documentExpiry'])
          && prefs.get('serviceDue', true) is bool
          && prefs.get('documentExpiry', true) is bool;
      }

      // activeBikeId, serviceIntervals and notificationPrefs are optional:
      // profiles created before they existed don't have them.
      function validProfile() {
        return data().keys().hasAll(['displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
          && data().keys().hasOnly([
            'displayName', 'email', 'photoURL', 'activeBikeId', 'serviceIntervals', 'notificationPrefs',
            'createdAt', 'updatedAt'
          ])
          && validServiceIntervals()
          && validNotificationPrefs()
          && isOptionalText(data().displayName, 100)
          // Must match the signed-in account's email (null for accounts without one).
          && data().email == request.auth.token.get('email', null)
          && isOptionalText(data().photoURL, 2048);
      }

      function activeBikeId() {
        return data().get('activeBikeId', null);
      }

      // A newly set active bike must be one of the owner's bikes. An unchanged
      // value is accepted so a stale id never blocks other profile edits.
      function validActiveBikeChange() {
        return activeBikeId() == resource.data.get('activeBikeId', null)
          || isOptionalBike(uid, activeBikeId());
      }

      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validProfile() && isOptionalBike(uid, activeBikeId())
        && validCreateTimestamps();
      allow update: if isOwner(uid) && validProfile() && validActiveBikeChange()
        && validUpdateTimestamps();
      // Account deletion: the app deletes every subcollection first, then the
      // profile, then the Auth user (src/lib/firestore/account.ts).
      allow delete: if isOwner(uid);

      // ---------- bikes ----------

      match /bikes/{bikeId} {
        function validBike() {
          return hasExactly([
              'make', 'model', 'engineCc', 'year', 'nickname', 'plateNumber',
              'odometerKm', 'photoPath', 'createdAt', 'updatedAt'
            ])
            && isText(data().make, 60)
            && isText(data().model, 60)
            && data().engineCc is int && data().engineCc >= 1 && data().engineCc <= 3000
            && data().year is int && data().year >= 1885 && data().year <= 2100
            && isOptionalText(data().nickname, 60)
            && isOptionalText(data().plateNumber, 20)
            && isNonNegative(data().odometerKm)
            // Photo must be stored under this bike's Storage folder.
            && (data().photoPath == null
              || (data().photoPath is string
                && data().photoPath.matches('users/' + uid + '/bikes/' + bikeId + '/[^/]{1,200}')));
        }

        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validBike() && validCreateTimestamps();
        allow update: if isOwner(uid) && validBike() && validUpdateTimestamps();

        // ---------- odometer history ----------

        // Append-only. Each reading is written in the same batch that sets the
        // bike's odometerKm, so the history always ends at the current reading.
        // Readings can be deleted, e.g. when the bike is deleted.
        match /odometerReadings/{readingId} {
          function bikePath() {
            return /databases/$(database)/documents/users/$(uid)/bikes/$(bikeId);
          }

          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid)
            && hasExactly(['odometerKm', 'createdAt'])
            && data().odometerKm is int && data().odometerKm >= 0
            && data().createdAt == request.time
            && existsAfter(bikePath())
            && getAfter(bikePath()).data.odometerKm == data().odometerKm;
          allow update: if false;
        }
      }

      // ---------- services (maintenance log) ----------

      match /services/{serviceId} {
        function validService() {
          return hasExactly([
              'bikeId', 'type', 'title', 'date', 'odometerKm', 'cost', 'notes',
              'nextDueKm', 'nextDueDate', 'createdAt', 'updatedAt'
            ])
            && bikeExists(uid, data().bikeId)
            && data().type in [
              'oil_change', 'tires', 'brakes', 'chain', 'battery',
              'inspection', 'repair', 'other'
            ]
            && isText(data().title, 120)
            && data().date is timestamp
            && isNonNegative(data().odometerKm)
            && isOptionalNonNegative(data().cost)
            && isOptionalText(data().notes, 2000)
            && isOptionalNonNegative(data().nextDueKm)
            && isOptionalTimestamp(data().nextDueDate);
        }

        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validService() && validCreateTimestamps();
        allow update: if isOwner(uid) && validService() && validUpdateTimestamps();
      }

      // ---------- documents (vault) ----------

      match /documents/{documentId} {
        // The photo is stored in Firestore as base64 chunks (photoChunks below),
        // since Cloud Storage needs a paid plan. Keep the limits in sync with
        // PHOTO_CHUNK_CHARS, MAX_PHOTO_CHUNKS and DOCUMENT_CONTENT_TYPES (types.ts).
        function validDocument() {
          return hasExactly([
              'bikeId', 'type', 'title', 'photoId', 'photoChunks', 'contentType',
              'sizeBytes', 'expiresAt', 'createdAt', 'updatedAt'
            ])
            && isOptionalBike(uid, data().bikeId)
            && data().type in ['registration', 'insurance', 'license', 'receipt', 'other']
            && isText(data().title, 120)
            && data().photoId is string
            && data().photoId.matches('[a-z0-9]{1,40}')
            && data().photoChunks is int && data().photoChunks >= 1 && data().photoChunks <= 8
            // The document may only point at a photo whose chunks are saved.
            && exists(/databases/$(database)/documents/users/$(uid)/documents/$(documentId)/photoChunks/$(data().photoId + '_0'))
            && data().contentType in ['image/jpeg', 'image/png', 'image/webp']
            && data().sizeBytes is int && data().sizeBytes > 0 && data().sizeBytes <= 5400000
            && isOptionalTimestamp(data().expiresAt);
        }

        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validDocument() && validCreateTimestamps();
        allow update: if isOwner(uid) && validDocument() && validUpdateTimestamps();

        // One piece of a photo's base64 text, named {photoId}_{index}. Written
        // once before the document points at it; never edited.
        match /photoChunks/{chunkId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid)
            && chunkId.matches('[a-z0-9]{1,40}_[0-7]')
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data is string
            && request.resource.data.data.size() > 0
            && request.resource.data.data.size() <= 900000;
          allow update: if false;
        }
      }

      // ---------- devices (push notifications) ----------

      // One phone that can receive push notifications. The id is a random
      // per-install id the app keeps; token is the native FCM token.
      // Keep platforms in sync with PUSH_PLATFORMS (types.ts).
      match /devices/{deviceId} {
        function validDevice() {
          return hasExactly(['token', 'platform', 'createdAt', 'updatedAt'])
            && isText(data().token, 4096)
            && data().platform in ['android'];
        }

        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && deviceId.matches('[A-Za-z0-9_-]{8,64}')
          && validDevice() && validCreateTimestamps();
        allow update: if isOwner(uid) && validDevice() && validUpdateTimestamps();
      }

      // ---------- chats (AI mechanic) ----------

      match /chats/{chatId} {
        function validChat() {
          return hasExactly(['title', 'bikeId', 'createdAt', 'updatedAt'])
            && isText(data().title, 120)
            && isOptionalBike(uid, data().bikeId);
        }

        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validChat() && validCreateTimestamps();
        allow update: if isOwner(uid) && validChat() && validUpdateTimestamps();

        // Append-only. The app writes the user's messages and the assistant's
        // replies, since it calls the AI provider directly (no backend).
        // Messages can be deleted, e.g. when the chat is deleted.
        match /messages/{messageId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid)
            && hasExactly(['role', 'text', 'createdAt'])
            && data().role in ['user', 'assistant']
            && isText(data().text, 4000)
            && data().createdAt == request.time;
          allow update: if false;
        }
      }
    }

    // ---------- wiki (reference content) ----------

    // Managed from the Firebase console or an admin script, never from the app.
    match /wiki/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
