{
  "expo": {
    "name": "MotoTrack",
    "slug": "mototrack-wiki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mototrackwiki",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mototrack.wiki",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mototrack.wiki",
      "googleServicesFile": "./src/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#C8102E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "MotoTrack opens your photos so you can save pictures of your OR/CR, insurance and license in the document vault.",
          "cameraPermission": "MotoTrack uses the camera so you can photograph your OR/CR, insurance and license for the document vault.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1EA",
          "dark": {
            "backgroundColor": "#131211"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#C8102E",
          "defaultChannel": "reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e7517e76-0d5b-42f9-9ca8-6cb9a3ec51eb"
      }
    }
  }
}
