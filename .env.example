# Firebase web app config — Firebase console > Project settings > Your apps > Web app.
# Copy these lines into .env and fill in the values. These are public client
# identifiers (bundled into the app), not secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In OAuth client IDs (Google Cloud console > APIs & Services > Credentials).
# Web client: required on all platforms (Android/iOS use it to get an idToken for Firebase).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=454985584750-nagfm7d6f9k7osadvti2oku9v5bbeaa4.apps.googleusercontent.com
# iOS client: only needed for iOS builds.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Wiki seed script (pnpm seed:wiki): path to a Firebase service account key JSON
# (Firebase console > Project settings > Service accounts). This one IS a secret:
# keep the key file outside the repo or under a name .gitignore already covers.
# Leave empty and set FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 to seed the emulator.
FIREBASE_SERVICE_ACCOUNT_PATH=

# AI mechanic (Groq, https://console.groq.com/keys). The app calls Groq directly,
# so this key IS bundled into the app and can be extracted from the APK. Use a
# free-tier key only: a leaked key can use up the shared daily quota.
EXPO_PUBLIC_GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-20b; use openai/gpt-oss-120b for deeper replies.
EXPO_PUBLIC_GROQ_MODEL=
