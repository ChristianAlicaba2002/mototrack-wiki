# Firebase web app config — Firebase console > Project settings > Your apps > Web app.
# Copy these lines into .env and fill in the values. These are public client
# identifiers (bundled into the app), not secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In OAuth client IDs (Google Cloud console > APIs & Services > Credentials).
# Web client: required on all platforms (Android/iOS use it to get an idToken for Firebase).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=454985584750-nagfm7d6f9k7osadvti2oku9v5bbeaa4.apps.googleusercontent.com
# iOS client: only needed for iOS builds.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
